# ── Core ──
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=                      # random string; pg_cron calls /api/cron/tick with it

# ── OpenRouter (AI) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ── Resend (email) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=team@yourdomain.com
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=            # whsec_... from Resend webhook settings

# ── Telnyx (SMS + voice) ──
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=                # for webhook signature verification
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=+15555555555
TELNYX_CONNECTION_ID=             # Credential connection (SIP) used for WebRTC
TELNYX_CREDENTIAL_ID=             # optional: auto-created on first dialer use if unset

# ── Calendly ──
CALENDLY_API_TOKEN=               # personal access token
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── PandaDoc ──
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_KEY=             # shared key from PandaDoc webhook settings

# ── Stripe (invoices + payment matching) ──
STRIPE_SECRET_KEY=                # sk_live_… (or a restricted key with Invoices, Customers, Charges write/read)
STRIPE_WEBHOOK_SECRET=            # whsec_… from the /api/webhooks/stripe endpoint

# ── Mercury (optional: US bank balance + transactions; Stripe takes precedence for invoices) ──
MERCURY_API_KEY=
MERCURY_ACCOUNT_ID=

# ── Google Calendar OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
